{
  "name": "mobile-agy",
  "version": "1.0.0",
  "description": "Mobile-friendly Telegram interface for Google Antigravity CLI via native stream-json",
  "main": "dist/index.js",
  "bin": {
    "mobile-agy": "./dist/bin/cli.js",
    "agy-telegram": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Mykola Odnosumov",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkloouo/mobile-agy.git"
  },
  "homepage": "https://github.com/mkloouo/mobile-agy#readme",
  "bugs": {
    "url": "https://github.com/mkloouo/mobile-agy/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "telegram",
    "ai",
    "cli",
    "headless",
    "remote",
    "mobile",
    "llm",
    "agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/cli.js",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "start": "node dist/bin/cli.js start",
    "dev": "ts-node-dev --respawn src/bin/cli.ts start"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "grammy": "^1.40.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
