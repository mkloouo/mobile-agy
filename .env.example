# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram User IDs allowed to access the bot (leave empty to allow anyone)
ALLOWED_USER_IDS=

# Base directory where your coding projects live (defaults to parent directory)
WORKSPACE_BASE_DIR=/Users/mkloouo/Projects

# Enable Telegram forum topics support
USE_TOPICS=true

# Automatically approve file edits / command executions without blocking
AUTO_APPROVE=true
